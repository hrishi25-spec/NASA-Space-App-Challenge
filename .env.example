# Pyro-Harmony configuration — copy to .env and edit.
# The backend loads the first .env it finds in firecal/backend/, in firecal/, or at the
# repo root, and a real environment variable always overrides the file. .env is git-ignored.

# Optional. Enables POST /api/archive: real 1–5 day FIRMS windows for a curated region or
# an explicit bbox, from a single source (MODIS_C6.1, VIIRS_S-NPP, VIIRS_NOAA-20,
# VIIRS_NOAA-21). Without it the console still runs the open 24 h feeds and CSV uploads.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional. Browser origins allowed to call the API. Defaults to the local dev servers
# (127.0.0.1/localhost on :5173 and :4173); set this when deploying the console elsewhere.
# ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
